# NPM registry configuration for publishing to both NPM and GitHub Packages
#
# For GitHub Packages:
# - Scoped packages (@auronsan/react-native-mantine) go to GitHub Packages
# - Unscoped packages (react-native-mantine) go to NPM
#
# Note: GitHub Package Registry requires authentication
# Set the NPM_TOKEN environment variable or use npm login

# Default registry (for unscoped packages)
registry=https://registry.npmjs.org/

# GitHub Packages registry for @auronsan scope
# Uncomment and configure when ready to publish scoped version
# @auronsan:registry=https://npm.pkg.github.com
